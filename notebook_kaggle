import pandas as pd
import numpy as np

# 1. Încărcăm tabelul aliniat brut
df = pd.read_csv('X_matrix_bucharest_2026_CP1_aligned.csv')

# 2. Filtrăm STRICT lunile de sezon cerute de tema U12 (Iarnă: Ian, Feb; Vară: Iun, Iul, Aug)
df['date_dt'] = pd.to_datetime(df['date'])
seasonal_months = [1, 2, 6, 7, 8]
df_clean = df[df['date_dt'].dt.month.isin(seasonal_months)].copy()

# 3. Conversie Dewpoint din Kelvin în grade Celsius
if 'umiditate_punct_roua' in df_clean.columns:
    if df_clean['umiditate_punct_roua'].mean() > 200:
        df_clean['umiditate_punct_roua'] = df_clean['umiditate_punct_roua'] - 273.15

# 4. Calculăm Viteza Vântului (modulul scalar al vântului în m/s)
if 'vant_u' in df_clean.columns and 'vant_v' in df_clean.columns:
    df_clean['viteza_vant'] = np.sqrt(df_clean['vant_u']**2 + df_clean['vant_v']**2)

# 5. Corectăm anomalia fizică TROPOMI: trunchiem valorile negative la 0
if 'NO2_satelit' in df_clean.columns:
    df_clean['NO2_satelit'] = df_clean['NO2_satelit'].clip(lower=0)

# 6. Eliminăm coloanele parasite / redundante
cols_to_drop = ['number', 'latitude', 'longitude', 'date_dt']
df_clean = df_clean.drop(columns=[c for c in cols_to_drop if c in df_clean.columns])

# 7. Reordonăm coloanele logic
ordered_cols = [
    'date', 'sensor_id', 'lat', 'lon', 
    'PM2.5', 'PM10', 
    'temperatura', 'umiditate_punct_roua', 'viteza_vant', 'vant_u', 'vant_v', 
    'boundary_layer_height', 'presiune_suprafata', 
    'NO2_satelit'
]
df_clean = df_clean[[c for c in ordered_cols if c in df_clean.columns]]

# 8. Rotunjim datele numerice la 4 zecimale pentru afișare și prezentare
float_cols = ['PM2.5', 'PM10', 'lat', 'lon', 'temperatura', 'umiditate_punct_roua', 'viteza_vant', 'vant_u', 'vant_v', 'boundary_layer_height', 'presiune_suprafata']
for col in float_cols:
    if col in df_clean.columns:
        df_clean[col] = df_clean[col].round(4)

# 9. Salvăm fișierul final
salvare_finala = 'X_matrix_bucharest_2026_CP1_FINAL.csv'
df_clean.to_csv(salvare_finala, index=False)

print(f"✅ SUCCES! Fișierul aliniat final a fost salvat ca '{salvare_finala}'.")
print(f"Dimensiune finală: {df_clean.shape[0]} rânduri × {df_clean.shape[1]} coloane.")
