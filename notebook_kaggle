import pandas as pd
from datetime import datetime, timedelta
from tqdm import tqdm

HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}

# Cei 10 senzori veterani din București pentru 2026
valid_sensors = [
    (85261, 'sds011'), (39082, 'sds011'), (84029, 'sds011'), 
    (65256, 'sds011'), (89277, 'sps30'),  (56776, 'sds011'), 
    (88307, 'sds011'), (88521, 'sps30'),  (94282, 'sps30'), 
    (87657, 'sds011')
]

start_date = datetime(2026, 1, 1)
end_date = datetime(2026, 9, 30)
date_list = [(start_date + timedelta(days=i)).strftime("%Y-%m-%d") for i in range((end_date - start_date).days + 1)]

print("Extragem și agregăm datele senzorilor din București (Ian-Sep 2026)...")
aligned_records = []

for s_id, stype in valid_sensors:
    print(f"Procesăm senzorul {s_id}...")
    for d in tqdm(date_list):
        url = f"https://archive.sensor.community/{d}/{d}_{stype}_sensor_{s_id}.csv"
        try:
            df = pd.read_csv(url, sep=";", storage_options=HEADERS)
            
            if 'P1' in df.columns: df.rename(columns={'P1': 'PM10'}, inplace=True)
            if 'P2' in df.columns: df.rename(columns={'P2': 'PM2.5'}, inplace=True)
            
            # Aliniere: media zilnică a măsurătorilor
            daily_mean = df[['PM10', 'PM2.5', 'lat', 'lon']].mean().to_dict()
            daily_mean['sensor_id'] = s_id
            daily_mean['date'] = d
            aligned_records.append(daily_mean)
        except:
            pass # Ignorăm zilele cu senzorul deconectat

if aligned_records:
    df_sensors_aligned = pd.DataFrame(aligned_records)
    df_sensors_aligned = df_sensors_aligned[['date', 'sensor_id', 'PM2.5', 'PM10', 'lat', 'lon']]

