import cdsapi
import os
import xarray as xr
import pandas as pd

# Configurare client API
c = cdsapi.Client()
os.makedirs("data/era5", exist_ok=True)

# Definim strict lunile de iarnă (Ian, Feb) și de vară (Iun, Iul, Aug)
lunile_tinta = ['01', '02', '06', '07', '08']
fisiere_nc = []

print("1. Descărcăm datele ERA5 strict pentru iarnă și vară 2026...")

for luna in lunile_tinta:
    fisier = f"data/era5/era5_bucharest_2026_{luna}.nc"
    fisiere_nc.append(fisier)
    
    if not os.path.exists(fisier):
        print(f" -> Se descarcă luna {luna}...")
        try:
            c.retrieve(
                'reanalysis-era5-single-levels',
                {
                    'product_type': 'reanalysis',
                    'format': 'netcdf',
                    'variable': [
                        '2m_temperature', '10m_u_component_of_wind', 
                        '10m_v_component_of_wind', '2m_dewpoint_temperature', 
                        'boundary_layer_height', 'surface_pressure'
                    ],
                    'year': ['2026'],
                    'month': [luna],
                    'day': [f"{d:02d}" for d in range(1, 32)], # API-ul ignoră zilele inexistente (ex. 30, 31 feb)
                    'time': [f"{h:02d}:00" for h in range(24)],
                    'area': [44.55, 25.95, 44.33, 26.25], 
                },
                fisier
            )
        except Exception as e:
            print(f"❌ Eroare la luna {luna}: {e}")
    else:
        print(f" -> Luna {luna} există deja pe disc.")

print("\n2. Procesăm fișierele și calculăm media zilnică...")
dfs = []

for fisier in fisiere_nc:
    if os.path.exists(fisier):
        ds = xr.open_dataset(fisier)
        df_luna = ds.to_dataframe().reset_index()
        
        df_luna['date'] = df_luna['valid_time'].dt.strftime('%Y-%m-%d')
        df_luna = df_luna.drop(columns=['valid_time', 'expver'], errors='ignore')
        
        df_zilnic = df_luna.groupby('date').mean(numeric_only=True).reset_index()
        dfs.append(df_zilnic)

if dfs:
    era5_final = pd.concat(dfs, ignore_index=True)
    
    era5_final.rename(columns={
        't2m': 'temperatura',
        'u10': 'vant_u',
        'v10': 'vant_v',
        'd2m': 'umiditate_punct_roua',
        'blh': 'boundary_layer_height',
        'sp':  'presiune_suprafata'
    }, inplace=True, errors='ignore')
    
    if 'temperatura' in era5_final.columns:
        era5_final['temperatura'] = era5_final['temperatura'] - 273.15
        
    salvare = "era5_bucharest_2026_seasons_aligned.csv"
    era5_final.to_csv(salvare, index=False)
    print(f"\n✅ SUCCES! Tabelul meteo de vară/iarnă are {len(era5_final)} zile și e salvat în '{salvare}'.")\

import ee
import pandas as pd
from datetime import datetime
from tqdm import tqdm

# ---> 1. PUNE AICI ID-UL TĂU EARTH ENGINE <---
PROJECT_ID = 'mede-512119'  # ex: 'ee-eliza-licenta'

print("Se inițializează conexiunea cu sateliții Google Earth Engine...")
try:
    ee.Initialize(project=PROJECT_ID)
    print("Conexiune stabilită din prima!")
except Exception as e:
    print("⚠️ E nevoie de autentificare pentru Earth Engine. Dă click pe linkul generat mai jos:")
    ee.Authenticate()  
    ee.Initialize(project=PROJECT_ID)

# 2. Setări Extragere (Bounding Box București)
geom = ee.Geometry.Rectangle([25.95, 44.33, 26.25, 44.55])

# Generăm lista de zile strict pentru iarnă (Ian-Feb) și vară (Iun-Aug) 2026
zile_iarna = pd.date_range(start='2026-01-01', end='2026-02-28').strftime('%Y-%m-%d').tolist()
zile_vara = pd.date_range(start='2026-06-01', end='2026-08-31').strftime('%Y-%m-%d').tolist()
toate_zilele = zile_iarna + zile_vara

date_satelit = []
print(f"\nExtragem datele troposferice de NO2 (Sentinel-5P) pentru {len(toate_zilele)} zile...")

for zi in tqdm(toate_zilele):
    start_date = ee.Date(zi)
    end_date = start_date.advance(1, 'day')
    
    colectie = ee.ImageCollection('COPERNICUS/S5P/NRTI/L3_NO2') \
                 .filterBounds(geom) \
                 .filterDate(start_date, end_date) \
                 .select('tropospheric_NO2_column_number_density')
    
    try:
        if colectie.size().getInfo() > 0:
            imagine_medie = colectie.mean()
            valoare_medie = imagine_medie.reduceRegion(
                reducer=ee.Reducer.mean(),
                geometry=geom,
                scale=1113.2, 
                maxPixels=1e9
            ).getInfo()
            
            no2_val = valoare_medie.get('tropospheric_NO2_column_number_density')
            if no2_val is not None:
                date_satelit.append({'date': zi, 'NO2_satelit': no2_val})
    except:
        pass 

# 3. Salvare rezultate
if date_satelit:
    df_s5p = pd.DataFrame(date_satelit)
    salvare_s5p = "s5p_bucharest_2026_seasons_aligned.csv"
    df_s5p.to_csv(salvare_s5p, index=False)
    print(f"\n✅ SUCCES! Am salvat datele satelitare pentru {len(df_s5p)} zile în '{salvare_s5p}'.")
