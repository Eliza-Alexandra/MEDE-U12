import pandas as pd

print("1. Încărcăm cele 3 seturi de date...")

# Calea către fișierul de senzori (încărcat ca Dataset în Kaggle)
cale_senzori = "/kaggle/input/datasets/caceelizaalexandra/sensor-community/sensors_bucharest_2026_aligned.csv" 

# Căile către fișierele meteo și satelit (generate în sesiunea curentă, în /kaggle/working/)
cale_meteo = "era5_bucharest_2026_seasons_aligned.csv"
cale_satelit = "s5p_bucharest_2026_seasons_aligned.csv"

try:
    df_senzori = pd.read_csv(cale_senzori)
    df_meteo = pd.read_csv(cale_meteo)
    df_satelit = pd.read_csv(cale_satelit)
    
    print("2. Executăm JOIN-ul final pe data calendaristică...")
    
    # Primul merge: Senzori + Meteo (păstrează strict intersecția de iarnă/vară)
    df_final = pd.merge(df_senzori, df_meteo, on='date', how='inner')
    
    # Al doilea merge: (Senzori+Meteo) + Satelit
    df_final = pd.merge(df_final, df_satelit, on='date', how='inner')
    
    print("3. Curățăm și uniformizăm datele...")
    
    # a. Ștergem coloanele redundante sau inutile
    coloane_de_sters = ['number', 'latitude', 'longitude']
    df_final = df_final.drop(columns=coloane_de_sters, errors='ignore')
    
    # b. Uniformizăm temperatura (umiditatea punctului de rouă din Kelvin în Celsius)
    if 'umiditate_punct_roua' in df_final.columns:
        # Verificăm dacă e în Kelvin (valori mari, pozitive, în mod normal peste 200 K)
        if df_final['umiditate_punct_roua'].mean() > 200:
            df_final['umiditate_punct_roua'] = df_final['umiditate_punct_roua'] - 273.15
            
    # Rotunjim datele meteo la 4 zecimale pentru a arăta profesional și curat
    coloane_de_rotunjit = ['temperatura', 'vant_u', 'vant_v', 'umiditate_punct_roua', 'boundary_layer_height']
    for col in coloane_de_rotunjit:
        if col in df_final.columns:
            df_final[col] = df_final[col].round(4)
            
    # 4. Curățare și Salvare Matricea X finală
    salvare_finala = "X_matrix_bucharest_2026_CP1.csv"
    df_final.to_csv(salvare_finala, index=False)
    
    print(f"\n✅ MATRICEA X ESTE GATA, CURĂȚATĂ ȘI UNIFORMIZATĂ! Fișierul '{salvare_finala}' a fost suprascris.")
    print(f"Număr total de observații aliniate: {len(df_final)}")
    print(f"Coloanele finale (curățate):\n{df_final.columns.tolist()}")

